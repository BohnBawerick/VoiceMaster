# VoiceMaster configuration. Copy to .env and fill in the values marked REQUIRED.
# A commented line is optional. Leave it commented rather than setting it empty: an empty
# value is still a value (an empty TWILIO_SIGNING_TOKENS would reject every webhook).
#
#   cp .env.example .env
#
# docker-compose.yml passes this file to every service. Never commit .env.
# The defaults here are the safe public ones: dashboard login on, outbound calls only to the
# owner's number, and an AI disclosure at the start of every outbound call. Loosen them on
# purpose, not by accident.

# ---------------------------------------------------------------------------
# Hermes (REQUIRED)
# ---------------------------------------------------------------------------
# Your Hermes gateway's OpenAI-compatible API server (API_SERVER_ENABLED=true in Hermes).
# The services run on the host network (docker-compose.yml), so this is the address as the
# host sees it. Per-profile gateways listen on 127.0.0.1 too, which is why.
HERMES_GATEWAY_URL=http://127.0.0.1:18789
# The bearer Hermes expects on its API server, and the bearer the phone bridge requires on
# POST /voice/outbound. Unset refuses every dial (fail-closed). Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
HERMES_GATEWAY_TOKEN=
# Extra per-profile gateways, if you do not run the profile supervisor from hermes/:
#   name=url,name=url
# HERMES_PROFILE_GATEWAY_URLS=
# The host path of your Hermes profiles directory. The dashboard mounts it to create Agents
# (an Agent is a Hermes profile). Unset, docker-compose.yml uses $HOME/.hermes/profiles.
# HERMES_PROFILES_HOST_DIR=/home/you/.hermes/profiles

# ---------------------------------------------------------------------------
# OpenAI Realtime, the default voice lane (REQUIRED)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_VOICE=cedar

# ---------------------------------------------------------------------------
# Twilio phone number (REQUIRED for the phone Outlet)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550100000
# Twilio signs webhooks with the auth token of the REGION that handled the call. Outside the
# US1 region that is a different secret from TWILIO_AUTH_TOKEN. List every token that may sign
# (comma-separated). Unset means TWILIO_AUTH_TOKEN alone. See docs/twilio.md.
# TWILIO_SIGNING_TOKENS=
# The public HTTPS host your tunnel sends to the phone bridge (no scheme, no path).
# Point the number's voice webhook at https://<this host>/voice/webhook (HTTP POST).
VOICE_PUBLIC_HOST=voice.example.com

# ---------------------------------------------------------------------------
# Who may call, and whom the Agents may call
# ---------------------------------------------------------------------------
# Callers allowed to reach an Agent inbound (comma-separated E.164). Empty rejects EVERY
# caller: an inbound Agent can use your Hermes tools.
VOICE_INBOUND_ALLOWED_CALLERS=+15550100001
# The owner's number, used by speed dial. Defaults to the first allowed caller.
# VOICE_OWNER_NUMBER=
# Numbers the Agents may dial (comma-separated E.164). The public default is the owner only.
# Empty means ANY number: only do that when you understand that a leaked HERMES_GATEWAY_TOKEN
# can then run up your Twilio bill.
VOICE_OUTBOUND_ALLOWED_NUMBERS=+15550100001
# Open every outbound call with an automated-caller disclosure. Many places require one by
# law (in the US, the FCC treats AI voices as "artificial" under the TCPA). You are
# responsible for the calling laws where you and the callee are.
VOICE_OUTBOUND_AI_DISCLOSURE=true

# ---------------------------------------------------------------------------
# Dashboard login
# ---------------------------------------------------------------------------
# HTTP basic auth on the dashboard. It turns on when BOTH are set. The dashboard can place
# real calls and play recordings; leave login off only behind a private network you trust.
VOICE_DASHBOARD_USER=owner
VOICE_DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Call archive
# ---------------------------------------------------------------------------
# Unset: a SQLite file beside the event log (./data/events/calls.sqlite3), nothing to run.
# Set HINDSIGHT_URL to archive into a Hindsight memory bank instead; create the bank first
# (docs/configuration.md). VOICE_ARCHIVE forces one: sqlite or hindsight.
# VOICE_ARCHIVE=
# HINDSIGHT_URL=
HINDSIGHT_BANK=voice
VOICE_RETAIN_ENABLED=true

# ---------------------------------------------------------------------------
# Features with a kill switch (no rebuild needed)
# ---------------------------------------------------------------------------
VOICE_RECORDING_ENABLED=true
VOICE_SUMMARY_ENABLED=true
VOICE_SCHEDULER_ENABLED=true
VOICE_HERMES_DIRECT_ENABLED=true
# Schedules are shown and resolved in this zone (IANA name). Defaults to the container's TZ.
VOICE_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# Optional providers (the cascade lanes and the Hermes direct lane)
# ---------------------------------------------------------------------------
# Only needed for Agents that pick these on their Voice tab. See docs/configuration.md.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# DEEPGRAM_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_API_KEY=
# NVIDIA_API_KEY=

# ---------------------------------------------------------------------------
# Nextcloud Talk Outlet (optional, experimental; `docker compose --profile talk up`)
# ---------------------------------------------------------------------------
# NEXTCLOUD_BASE_URL=https://nextcloud.example.com
# NEXTCLOUD_TALK_USER=
# NEXTCLOUD_TALK_HOME_CONVERSATION=
# NEXTCLOUD_VOICE_APP_PASSWORD=
# NEXTCLOUD_VOICE_LOGIN_PASSWORD=
